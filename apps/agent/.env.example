# Beethoven AI Avatar Agent Environment Variables
# Copy this to .env and fill in your values

# LiveKit - Real-time voice/video infrastructure
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://news.englisch-lehrer.com

# Beyond Presence - Real-time AI video avatars (deprecated — replaced by Bithuman)
BEY_API_KEY=sk-your_beyond_presence_key
BEY_AVATAR_ID=your-avatar-uuid

# Bithuman - Real-time avatar (https://www.bithuman.ai/#developer)
# Plugin reads BITHUMAN_API_SECRET (not _API_KEY — matches livekit-plugins-bithuman contract)
BITHUMAN_API_SECRET=your_bithuman_api_secret
BITHUMAN_FIGURE_ID=your_figure_id

# Google Gemini Live - Realtime multimodal voice model
GOOGLE_API_KEY=your_google_api_key
GEMINI_VOICE_MALE=Alnilam
GEMINI_VOICE_FEMALE=Aoede

# Hedra - Real-time avatars with sub-100ms latency ($0.05/min)
# Alternative to Beyond Presence - faster cold start
HEDRA_API_KEY=sk_hedra_your_hedra_api_key

# Cartesia - Ultra-low latency TTS (Sonic-3)
CARTESIA_API_KEY=sk_car_your_cartesia_key

# Deepgram - Real-time STT (Nova-2)
DEEPGRAM_API_KEY=your_deepgram_key

# OpenRouter - LLM API (Claude, GPT, etc.)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key

# Cerebras - Ultra-fast LLM inference (2,314 tok/s) - OPTIONAL
# Only required if you select Cerebras as LLM provider for an avatar
CEREBRAS_API_KEY=csk-your_cerebras_key

# Groq - Ultra-fast LLM inference (~40ms TTFT) - OPTIONAL
# Only required if you select Groq as LLM provider for an avatar
GROQ_API_KEY=gsk_your_groq_key

# Inception Labs - Mercury diffusion LLM (1000+ tok/s reasoning) - OPTIONAL
# Only required if you select Mercury as LLM provider for an avatar
INCEPTION_API_KEY=sk_your_inception_key

# Convex - Backend database
CONVEX_URL=https://your-project.convex.cloud

# Tavily - Web search for current affairs/news - OPTIONAL
# Only required for conversation practice with web search enabled
TAVILY_API_KEY=tvly-your_tavily_key
